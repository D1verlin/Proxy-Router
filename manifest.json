{
  "manifest_version": 3,
  "name": "Smart Proxy: AI & Google",
  "version": "1.0.2",
  "description": "Перенаправление трафика Google (кроме YouTube), Gemini, Claude, OpenAI и Google Stitch через HTTP прокси.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Smart Proxy: AI & Google",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "proxy",
    "storage"
  ]
}
